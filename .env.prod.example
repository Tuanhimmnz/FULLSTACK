APP_DOMAIN=103.77.242.126
APP_PUBLIC_URL=http://103.77.242.126
VITE_API_BASE_URL=http://103.77.242.126/api
FRONTEND_ROOT=/var/www/sprintflow

MSSQL_SA_PASSWORD=ChangeThisStrongPassword@2026
JWT_SECRET=ChangeThisJwtSecret.AtLeast.32.Characters.For.Production
JWT_ISSUER=SprintFlow
JWT_AUDIENCE=SprintFlow.Client

ASPNETCORE_ENVIRONMENT=Production

# RabbitMQ Event Broker. Backend service publish event thật qua RabbitMQ,
# NotifyService consume queue để tạo notification/activity log.
RABBITMQ_ENABLED=true
RABBITMQ_USER=sprintflow
RABBITMQ_PASSWORD=ChangeThisRabbitPassword@2026
RABBITMQ_EXCHANGE=sprintflow.events
RABBITMQ_QUEUE=notify.events

# AI provider token chỉ đặt ở backend, không đưa vào Vue.
# Để trống thì backend chạy fallback assistant dựa trên data project/task/user thật.
AI_PROVIDER_TOKEN=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
